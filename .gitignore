# ── Python ────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/

# ── Virtual environments ───────────────────────────────────
venv/
env/
.venv/
.env/

# ── Analysis results (regenerable) ─────────────────────────
analysis/results/

# ── Memory system data (regenerable) ──────────────────────
memory/data/

# ── Cross-layer Phase 2 artifacts (regenerable; large) ────
memory/cross_layer/data/

# ── Dataset data (too large for git; use HuggingFace Hub) ──
dataset/data/raw/
dataset/data/processed/
dataset/data/dataset/
dataset/data/training/
dataset/data/index.jsonl
dataset/data/*.log
dataset/data/*.db

# ── Keep the data directory structure (not its contents) ──
!dataset/data/.gitkeep
!dataset/data/raw/.gitkeep
!dataset/data/processed/.gitkeep
!dataset/data/dataset/.gitkeep
!dataset/data/training/.gitkeep

# ── Evaluation data (downloaded cases, results, build artifacts) ──
evaluation/cases/
evaluation/results/
evaluation/kernel/
evaluation/ccache/
evaluation/rootfs/
evaluation/workdir/
evaluation/initramfs.cpio.gz

