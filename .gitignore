# ── Python ────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg-info/
dist/
build/
.eggs/

# ── Virtual environments ───────────────────────────────────
venv/
env/
.venv/
.env/

# ── Analysis results (regenerable; may be a symlink) ──────
analysis/results

# ── Dataset data (too large for git; use HuggingFace Hub) ──
# No trailing slashes: entries may be symlinks to a shared data location.
# All of these are auto-created by the pipeline (mkdir parents=True).
dataset/data/raw
dataset/data/processed
dataset/data/dataset
dataset/data/training
dataset/data/index.jsonl
dataset/data/.cache
dataset/data/*.log
dataset/data/*.db

# ── Keep the data directory itself ─────────────────────────
!dataset/data/.gitkeep

# ── MkDocs site build ─────────────────────────────────────
site/

# ── Editor / OS ───────────────────────────────────────────
.DS_Store
.idea/
.vscode/
*.swp
*.swo
*~

# ── Claude internal ───────────────────────────────────────
.claude/
.codex
